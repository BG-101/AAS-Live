# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/<dbname>

# Secreto JWT — genera uno con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<string_aleatorio_64_bytes>

# Entorno
NODE_ENV=development

# Habilitar endpoint de setup inicial (solo para primer arranque)
ALLOW_SETUP=true

# URL del frontend (necesaria en producción para CORS)
CLIENT_URL=http://localhost:5173

RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=100
BODY_LIMIT=10kb
JWT_EXPIRES_IN=48h
COOKIE_MAX_AGE_MS=172800000
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<set-a-strong-secret-out-of-band>