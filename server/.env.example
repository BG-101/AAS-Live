# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/<dbname>

# Secreto JWT — genera uno con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Entorno
NODE_ENV=development

# Habilitar endpoint de setup inicial (solo para primer arranque)
ALLOW_SETUP=true

# URL del frontend (necesaria en producción para CORS)
CLIENT_URL=http://localhost:5173

RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=100
BODY_LIMIT=10kb
JWT_EXPIRES_IN=48h
COOKIE_MAX_AGE_MS=172800000
DEFAULT_ADMIN_USERNAME=admin

# Contraseña de administrador generado al llamar a /api/auth/setup. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEFAULT_ADMIN_PASSWORD=

# Token que debe enviarse al header X-Setup-Token para poder llamar a /api/auth/setup.
# Mínimo 20 caracteres y 8 distintos; se rechazan valores repetitivos/comunes.
# OBLIGATORIO: genera un valor único por despliegue, no copies un ejemplo.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_BOOTSTRAP_TOKEN=

# Opcionales, solo relevantes para MongoDB self-hosted/on-premise
# Descomenta y ajusta SOLO si tu despliegue lo requiere; en Atlas no se usan.
# MONGO_TLS_CA_FILE=/ruta/al/ca.pem
# MONGO_AUTH_SOURCE=admin
# MONGO_REPLICA_SET=rs0

# Días tras el endDate duranto los cuales un Delegado aún puede editar
# (tiempos, competidores, rondas). Pasado ese plazo, solo SuperAdmin.
DELEGATE_EDIT_WINDOW_DAYS = 2