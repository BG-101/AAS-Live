#!/usr/bin/env sh
# Activar una vez por clone: git config core.hooksPath .githooks && chmod +x .githooks/pre-commit

blocked=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.env\.example$')

if [ -n "$blocked" ]; then
    echo "❌ Commit bloqueado: archivo .env con posibles secretos:"
    echo "$blocked"
    echo "Si es un ejemplo, renómbralo a .env.example."
    exit 1
fi
exit 0